# 2. COMPUTE HARVESTED AREA 
# For this, we are not using EarthStat as the harvested area can exceed grid cell size to account for multiple harvests in this data source.
# We compute harvested area using fractional data from EarthStat instead, as follows: sum(fractional area * cell area).

# Function for computing harvested area (help used here: https://rstudio-pubs-static.s3.amazonaws.com/253036_5c8c0e52023b4fcbafdb76cada296758.html):

harvested_area_funct = function(ras_stack) { 
  for (i in 1:nlayers(ras_stack)) {
    cell_size_multiplier = mean(raster::area(ras_stack[[i]]))
    process_step1 = cell_size_multiplier * ras_stack[[i]]
    raster::writeRaster(process_step1, filename = paste0(outDir, "harvested_area_calculated", names(ras_stack[[i]])), format = "GTiff", overwrite = TRUE)
  }}

# Running the function for different crop groupings and each country:

cashcrops_GHA =  harvested_area_funct(ras_stack = cash_GHA)
